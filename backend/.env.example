# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Option A: Connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/quest_db

# Option B: Individual fields (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quest_db
DB_USER=postgres
DB_PASSWORD=password

# Connection pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── Socket.io ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:19000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
